# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Runtime artifacts written into the app directory.
# error.log records every processed filename and its full local path -
# never commit it.
error.log
error.log.*
settings.json
# Only exists mid-save, but a process that dies can strand one.
settings.json.tmp

# Editor / backup files
*.bak
